; Protocolo Ônix — projeto Godot 4.7 (Forward+)
config_version=5

[application]

config/name="Protocolo Ônix"
config/description="Tática isométrica em tempo real num Brasil cyberpunk."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Shot="*res://scripts/dev/shot.gd"
Lang="*res://scripts/core/lang.gd"
Camp="*res://scripts/campaign/camp.gd"
Snd="*res://scripts/core/snd.gd"
Portraits="*res://scripts/ui/portraits.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="disabled"

[rendering]

rendering_device/driver.windows="vulkan"
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/screen_space_aa=0
textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/import_etc2_astc=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=4096
environment/ssao/quality=2
environment/ssil/quality=1
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/screen_space_reflection/roughness_quality=2
limits/cluster_builder/max_clustered_elements=1024
anti_aliasing/screen_space_roughness_limiter/enabled=true

[shader_globals]

cut_cam={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cut_pos={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
cut_r={
"type": "float",
"value": 0.0
}
