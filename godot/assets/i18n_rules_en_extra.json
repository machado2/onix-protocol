[
  ["^(\\S+)  (\\d+)/(\\d+)(  recarregando)?$", "{t1}  {2}/{3}{?4:  reloading}"],
  ["^COLAPSO (\\d+)s$", "BREAKDOWN {1}s"],
  ["^(.+)   ·   (\\d+) missões$", "{1}   ·   {2} missions"],
  ["^(.+) entrou em revolta! Reprima-a em até 2 dias ou o distrito volta ao Consórcio\\.$", "{1} has revolted! Suppress it within 2 days or the district goes back to the Consortium."],
  ["^(.+) foi (?:extraída|extraído) com sucesso\\.$", "{t1} was extracted successfully."],
  ["^(.+) foi (?:morta|morto) no fogo cruzado\\.$", "{t1} was killed in the crossfire."],
  ["^(.+) se juntou ao esquadrão\\. Leve-[ao] ao ponto de evacuação\\.$", "{t1} joined the squad. Get them to the evac point."],
  ["^(.+)  —  (.+)   ·   dia (\\d+)$", "{t1}  —  {t2}   ·   day {3}"],
  ["^A Ônix enviou (?:agentes|um agente) de reposição: (.+)\\.$", "Ônix sent replacement agents: {1}."],
  ["^Abates: (\\d+) · civis: (\\d+) · policiais: (\\d+) · seguidores: (\\d+)$", "Kills: {1} · civilians: {2} · police: {3} · followers: {4}"],
  ["^Agitadores do Consórcio tomaram as ruas\\. Reprima a revolta em (\\d+) dia\\(s\\) ou o distrito volta ao Consórcio\\.$", "Consortium agitators have taken the streets. Suppress the revolt within {1} day(s) or the district goes back to the Consortium."],
  ["^Clínica \\$([\\d.]+)$", "Clinic ${m1}"],
  ["^Derrube os pilares de escudo do átrio \\((\\d)/2\\)$", "Destroy the atrium's shield pylons ({1}/2)"],
  ["^Encontre (.+) e leve-[ao] de volta ao ponto de entrada\\.$", "Find {t1} and bring them back to the insertion point."],
  ["^Invada os terminais do Consórcio \\((\\d+)/(\\d+)\\)\\.$", "Hack the Consortium terminals ({1}/{2})."],
  ["^Missão: (.+?)\\. (.+)$", "Mission: {t1}. {t2}"],
  ["^Montando o distrito · (.+)$", "Building the district · {t1}"],
  ["^Pesquisa concluída: (.+?)\\. (.+)$", "Research complete: {t1}. {t2}"],
  ["^POLÍCIA HOSTIL (\\d+)s$", "HOSTILE POLICE {1}s"],
  ["^SEGUIDORES (\\d+)$", "FOLLOWERS {1}"],
  ["^PROTOCOLO ÔNIX · (.+)$", "PROTOCOLO ÔNIX · {t1}"],
  ["^ÔNIX · (.+)$", "ÔNIX · {t1}"],
  ["^dano (\\S+) · alcance ([\\d,.]+) · ([\\d,.]+) tiros/s · pente (\\d+)$", "damage {1} · range {2} · {3} shots/s · mag {4}"],
  ["^dano (\\S+) em área · alcance ([\\d,.]+)$", "damage {1} area · range {2}"],
  ["^fogo · alcance ([\\d,.]+)$", "fire · range {1}"],
  ["^ONX-(\\d+) · CLASSIFICADO$", "ONX-{1} · CLASSIFIED"],
  ["^NEURAL · (.+)$", "NEURAL · {1}"],
  ["^\\+ (.+)  \\$(\\d+)$", "+ {t1}  ${2}"],
  ["^F(\\d) ARREMESSAR$", "F{1} THROW"],
  ["^F(\\d) USAR$", "F{1} USE"],
  ["^(.+) \\(caçando\\)$", "{t1} (hunting)"],
  ["^(.+) \\(desligada\\)$", "{t1} (offline)"],
  ["^(.+) \\(alerta\\)$", "{t1} (alert)"],
  ["^Elimine (.+) antes que ele chegue ao transporte\\.$", "Eliminate {t1} before he reaches the transport."],
  ["^Elimine os agentes do Consórcio \\((\\d+) restantes\\)\\.$", "Eliminate the Consortium agents ({1} left)."],
  ["^Elimine os agitadores do Consórcio \\((\\d+) restantes\\)\\.$", "Eliminate the Consortium agitators ({1} left)."],
  ["^(.+): (.+)$", "{1}: {t2}"]
]
